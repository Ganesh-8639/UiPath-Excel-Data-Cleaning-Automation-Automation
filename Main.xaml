          <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Create Data Quality Status column&#xA;If Not dt.Columns.Contains(&quot;Data_Quality_Status&quot;) Then&#xA;    dt.Columns.Add(&quot;Data_Quality_Status&quot;, GetType(String))&#xA;End If&#xA;&#xA;' Process every row&#xA;For Each row As DataRow In dt.Rows&#xA;&#xA;    ' 1. Customer_ID&#xA;    If Not row.IsNull(&quot;Customer_ID&quot;) Then&#xA;        row(&quot;Customer_ID&quot;) = row(&quot;Customer_ID&quot;).ToString.Trim()&#xA;    End If&#xA;&#xA;    ' 2. First_Name&#xA;    If Not row.IsNull(&quot;First_Name&quot;) Then&#xA;        row(&quot;First_Name&quot;) = Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(&#xA;            row(&quot;First_Name&quot;).ToString.Trim().ToLower())&#xA;    End If&#xA;&#xA;    ' 3. Last_Name&#xA;    If Not row.IsNull(&quot;Last_Name&quot;) Then&#xA;        row(&quot;Last_Name&quot;) = Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(&#xA;            row(&quot;Last_Name&quot;).ToString.Trim().ToLower())&#xA;    End If&#xA;&#xA;    ' 4. Phone_Number - keep digits only&#xA;    Dim phoneText As String = &quot;&quot;&#xA;&#xA;    If Not row.IsNull(&quot;Phone_Number&quot;) Then&#xA;        phoneText = System.Text.RegularExpressions.Regex.Replace(&#xA;            row(&quot;Phone_Number&quot;).ToString(), &quot;[^0-9]&quot;, &quot;&quot;)&#xA;        row(&quot;Phone_Number&quot;) = phoneText&#xA;    End If&#xA;&#xA;    ' 5. Email - trim and lowercase&#xA;    Dim emailText As String = &quot;&quot;&#xA;&#xA;    If Not row.IsNull(&quot;Email&quot;) Then&#xA;        emailText = row(&quot;Email&quot;).ToString.Trim().ToLower()&#xA;        row(&quot;Email&quot;) = emailText&#xA;    End If&#xA;&#xA;    ' 6. City&#xA;    If Not row.IsNull(&quot;City&quot;) Then&#xA;        row(&quot;City&quot;) = Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(&#xA;            row(&quot;City&quot;).ToString.Trim().ToLower())&#xA;    End If&#xA;&#xA;    ' 7. State&#xA;    If Not row.IsNull(&quot;State&quot;) Then&#xA;        row(&quot;State&quot;) = Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(&#xA;            row(&quot;State&quot;).ToString.Trim().ToLower())&#xA;    End If&#xA;&#xA;    ' 8. Department&#xA;    If Not row.IsNull(&quot;Department&quot;) Then&#xA;        row(&quot;Department&quot;) = Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(&#xA;            row(&quot;Department&quot;).ToString.Trim().ToLower())&#xA;    End If&#xA;&#xA;    ' 9. Registration_Date - trim spaces&#xA;    If Not row.IsNull(&quot;Registration_Date&quot;) Then&#xA;        row(&quot;Registration_Date&quot;) = row(&quot;Registration_Date&quot;).ToString.Trim()&#xA;    End If&#xA;&#xA;    ' 10. Amount - remove currency symbols and commas&#xA;    If Not row.IsNull(&quot;Amount&quot;) Then&#xA;        Dim amountText As String = row(&quot;Amount&quot;).ToString.Trim()&#xA;&#xA;        amountText = System.Text.RegularExpressions.Regex.Replace(&#xA;            amountText, &quot;[^0-9.]&quot;, &quot;&quot;)&#xA;&#xA;        row(&quot;Amount&quot;) = amountText&#xA;    End If&#xA;&#xA;    ' 11. Status - standardize values&#xA;    If Not row.IsNull(&quot;Status&quot;) Then&#xA;&#xA;        Dim statusText As String = row(&quot;Status&quot;).ToString.Trim().ToLower()&#xA;&#xA;        If statusText = &quot;active&quot; Then&#xA;            row(&quot;Status&quot;) = &quot;Active&quot;&#xA;&#xA;        ElseIf statusText = &quot;inactive&quot; Then&#xA;            row(&quot;Status&quot;) = &quot;Inactive&quot;&#xA;&#xA;        ElseIf statusText = &quot;pending&quot; Then&#xA;            row(&quot;Status&quot;) = &quot;Pending&quot;&#xA;        End If&#xA;&#xA;    End If&#xA;&#xA;    ' 12. Validate Email&#xA;    Dim emailInvalid As Boolean = False&#xA;&#xA;    If String.IsNullOrWhiteSpace(emailText) Then&#xA;        emailInvalid = True&#xA;    ElseIf Not System.Text.RegularExpressions.Regex.IsMatch(&#xA;        emailText,&#xA;        &quot;^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$&quot;) Then&#xA;&#xA;        emailInvalid = True&#xA;    End If&#xA;&#xA;    ' 13. Validate Phone Number&#xA;    Dim phoneInvalid As Boolean = False&#xA;&#xA;    If String.IsNullOrWhiteSpace(phoneText) Then&#xA;        phoneInvalid = True&#xA;    ElseIf Not System.Text.RegularExpressions.Regex.IsMatch(&#xA;        phoneText,&#xA;        &quot;^[6-9][0-9]{9}$&quot;) Then&#xA;&#xA;        phoneInvalid = True&#xA;    End If&#xA;&#xA;    ' 14. Set Data Quality Status&#xA;    If emailInvalid OrElse phoneInvalid Then&#xA;        row(&quot;Data_Quality_Status&quot;) = &quot;Has Issues&quot;&#xA;    Else&#xA;        row(&quot;Data_Quality_Status&quot;) = &quot;OK&quot;&#xA;    End If&#xA;&#xA;Next" DisplayName="space cleaning" sap:VirtualizedContainerService.HintSize="451.2,400.8" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
